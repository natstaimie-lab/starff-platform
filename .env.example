# Copy this file to `.env` and fill in the real values.
# NEVER commit the real .env file.

# ── Database (from Supabase → Project Settings → Database → Connection string) ──
# Use the "Session" / direct connection string (port 5432) for migrations.
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres"

# ── Supabase (from Supabase → Project Settings → API) ──
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-side only, keep secret
# JWT Secret from Project Settings → API → JWT Settings. The API uses this to
# verify that login tokens are genuine.
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# ── API ──
API_PORT=3001

# ── AI Assistant (Anthropic) ──
# Get a key at https://console.anthropic.com → API Keys. Enables the admin AI Assistant.
ANTHROPIC_API_KEY="sk-ant-..."

# ── WordPress webhook ──
# A shared secret the WordPress form sends so the API knows the request is genuine.
# Also protects the public /registration/candidate and /registration/client endpoints.
WORDPRESS_WEBHOOK_SECRET="generate-another-long-random-string"

# ── Portals (where registrants are sent after the website/app front door) ──
CANDIDATE_PORTAL_URL="http://localhost:3002"
CLIENT_PORTAL_URL="http://localhost:3003"

# ── Transactional email (Resend) ──
# Powers registration/onboarding emails beyond Supabase's built-in verification.
# Leave blank and the app runs fine — emails are logged & skipped until a key is set.
# Get a key at https://resend.com → API Keys.
RESEND_API_KEY=""
MAIL_FROM="Starff <noreply@starff.co.uk>"

# Field-level encryption for sensitive candidate data (bank details, NI).
# Any high-entropy secret; a 32-byte key is derived from it via SHA-256.
# Generate one with: openssl rand -base64 32
# KEEP THIS STABLE and backed up — changing it makes existing encrypted data unreadable.
ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
