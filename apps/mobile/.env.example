# ─────────────────────────────────────────────────────────────
# Starff Mobile — environment configuration
#
# Copy this file to `.env` (development). For staging/production
# create `.env.staging` / `.env.production` and select them with
# the APP_ENV var when building (see docs/MOBILE.md).
#
# Only EXPO_PUBLIC_* vars are readable in the app at runtime.
# These are NOT secrets — the Supabase anon key and API URL are
# safe to ship in a client. Never put the Supabase SERVICE key,
# the DB URL, or the webhook secret in here.
# ─────────────────────────────────────────────────────────────

# Which environment this build points at: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Starff API (the ONE shared NestJS backend — same as admin/portals use).
# Physical devices cannot reach "localhost"; use your machine's LAN IP
# (e.g. http://192.168.1.20:3001/api/v1) or a tunnel (cloudflared / ngrok).
EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1

# Supabase Auth — the SAME project the whole platform uses.
# Project ref: vtmafvssthoypwgcjtkm (eu-west-1). anon key only.
EXPO_PUBLIC_SUPABASE_URL=https://vtmafvssthoypwgcjtkm.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
