{
  // This app is intentionally NOT part of the repo's npm workspaces: it needs
  // its own React / React Native, while the Next.js portals use React 18. Its
  // dependencies are installed standalone in apps/mobile/node_modules. typeRoots
  // is pinned here so the workspace root's React 18 types can't leak in.
  // (No baseUrl — modern TS resolves `paths` relative to this file.)
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
