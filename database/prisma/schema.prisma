// ─────────────────────────────────────────────────────────────
// Starff Platform — shared database schema
// PostgreSQL (hosted on Supabase), managed with Prisma.
//
// This ONE schema is the single source of truth for the whole
// platform: admin dashboard, candidate portal, client portal,
// mobile app, and the WordPress forms all read/write these tables
// through the shared API.
//
// Money is stored as Decimal(10,2). Times are stored as DateTime.
// User identity (login/passwords) is handled by Supabase Auth;
// the `User` table below mirrors each auth user so we can attach
// data and relations to them.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════
// ENUMS  (fixed sets of allowed values)
// ══════════════════════════════════════════════

enum Role {
  ADMIN        // your staff — full access
  RECRUITER    // your consultants — manage candidates/jobs
  CANDIDATE    // temp workers
  CLIENT       // hiring companies
}

enum DbsLevel {
  BASIC
  STANDARD
  ENHANCED
}

enum CandidateStatus {
  NEW          // just registered / applied
  SCREENING    // being vetted by a recruiter
  COMPLIANT    // documents verified — cleared to work
  ACTIVE       // currently working shifts
  INACTIVE
  REJECTED
}

enum ClientStatus {
  LEAD         // came in via "Post a Job" form
  PROSPECT
  ACTIVE
  ON_HOLD
  CLOSED
}

enum RegistrationSource {
  WEBSITE      // started on the WordPress site
  MOBILE       // started in the mobile app
  PORTAL       // self-registered directly in the portal
  ADMIN        // created by a staff member
}

enum DocumentType {
  RIGHT_TO_WORK
  DBS_CHECK
  ID
  CV
  CERTIFICATE
  REFERENCE
  CONTRACT
  QUALIFICATION
  LICENCE
  SELFIE
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum JobStatus {
  DRAFT
  OPEN                    // legacy / directly-published job (pre-workflow)
  // ── controlled hybrid workflow stages ──
  SUBMITTED              // client submitted the request, awaiting admin
  UNDER_REVIEW           // admin is reviewing
  APPROVED               // admin approved, not yet distributing
  RECRUITING             // approved + matching candidates ("Matching candidates")
  OFFERS_SENT            // offers sent to candidates, awaiting responses
  CANDIDATES_SUBMITTED   // candidates put forward to the client ("Awaiting client approval")
  PARTIALLY_FILLED       // some but not all openings booked
  FILLED                 // all openings booked ("Fully filled")
  CONFIRMED              // all workers confirmed & acknowledged
  IN_PROGRESS            // shift is underway
  COMPLETED
  CLOSED
  CANCELLED
}

enum ShiftStatus {
  OPEN          // needs a worker
  ASSIGNED      // a candidate is booked
  CONFIRMED     // candidate confirmed attendance
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  OFFERED
  ACCEPTED
  DECLINED
  REJECTED
  WITHDRAWN
  // ── controlled hybrid workflow pipeline stages ──
  RECOMMENDED            // matched by the system, not yet actioned
  INVITED                // admin pushed the job to the candidate
  INTERESTED             // candidate confirmed available & interested
  UNAVAILABLE            // candidate not available
  INFO_REQUESTED         // candidate asked for more information
  SUBMITTED_TO_CLIENT    // admin put candidate forward to the client
  CLIENT_ACCEPTED        // client accepted the candidate
  CLIENT_REJECTED        // client rejected the candidate
  ALTERNATIVE_REQUESTED  // client asked for an alternative
  BOOKED                 // admin confirmed the final placement
  REPLACED               // booking cancelled / replaced (history kept)
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED     // candidate submitted hours
  APPROVED      // client/recruiter approved
  REJECTED
  INVOICED
  PAID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum EnquiryType {
  CONTACT             // "Contact us" form
  POST_A_JOB          // "For Employers" form
  CANDIDATE_REGISTER  // "For Candidates" form
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum ConversationKind {
  CANDIDATE
  CLIENT
}

// ══════════════════════════════════════════════
// USERS  (mirrors Supabase Auth users)
// ══════════════════════════════════════════════

model User {
  id            String         @id @db.Uuid   // == Supabase auth.users.id
  email         String         @unique
  role          Role           @default(CANDIDATE)
  firstName     String?
  lastName      String?
  phone         String?
  avatarUrl     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // In-app account deletion (App Store / Play requirement). A user requests
  // deletion from the app: we deactivate immediately and flag the account;
  // admin completes erasure honouring statutory retention (RTW/payroll).
  deletionRequestedAt DateTime?
  deletionHandledAt   DateTime?
  deletionReason      String?

  candidate     Candidate?
  clientContact ClientContact?
  notifications Notification[]
  auditLogs     AuditLog[]
  conversations Conversation[]
  pushTokens    PushToken[]

  @@index([role])
}

// ══════════════════════════════════════════════
// CANDIDATES  (temp workers)
// ══════════════════════════════════════════════

model Candidate {
  id                 String              @id @default(cuid())
  userId             String              @unique @db.Uuid
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName          String
  lastName           String
  dateOfBirth        DateTime?
  phone              String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  postcode           String?
  nationalInsurance  String?             // encrypt at app level
  status             CandidateStatus     @default(NEW)
  available          Boolean             @default(true)
  headline           String?             // e.g. "Warehouse Operative, 3yrs"
  bio                String?
  rating             Float?              // internal 0–5 rating
  maxTravelMiles     Int?
  preferredSectors   String[]  @default([]) // what work they're looking for (sign-up)

  // ── registration / onboarding tracking (additive, all nullable) ──
  registrationSource RegistrationSource? // where they first registered
  submittedAt        DateTime?           // set when they submit for review
  archivedAt         DateTime?           // soft-delete: hidden from lists, recoverable
  lastReminderAt     DateTime?           // last "finish your registration" nudge sent
  reminderCount      Int       @default(0) // how many nudges sent (capped)

  // ── Phase 2 onboarding: emergency contact ──
  emergencyName          String?
  emergencyPhone         String?
  emergencyRelationship  String?
  // ── bank details — SENSITIVE: encrypt at app level before production ──
  bankAccountName        String?
  bankSortCode           String?
  bankAccountNumber      String?
  // ── work preferences ──
  shiftPreference        String?         // Days | Nights | Any
  uniformSize            String?
  shoeSize               String?
  rightToWorkType        String?         // British Citizen | Settled | Visa …
  shareCode              String?         // RTW online share code
  // ── driving licence (DVLA check) ──
  drivingLicenceNumber   String?         // the driver's DVLA licence number
  dvlaCheckCode          String?         // driver-generated "share code" from gov.uk/view-driving-licence (21-day validity)
  dvlaCheckCodeAt        DateTime?       // when the driver last supplied a check code
  // ── DBS (optional — only some jobs need it). Details only, admin verifies ──
  dbsLevel               DbsLevel?
  dbsIssueDate           DateTime?
  dbsCertificateNumber   String?         // 12-digit certificate number (redacted for recruiters)
  dbsUpdateService       Boolean?        // subscribed to the DBS Update Service
  dbsSuppliedAt          DateTime?       // when the worker last entered/changed details
  dbsVerifiedAt          DateTime?       // set by ADMIN after checking; cleared if details change
  dbsVerifiedById        String?         // User.id of the admin who verified
  // ── declarations / consents / agreement / e-signature ──
  healthDeclaration      Boolean         @default(false)
  healthNotes            String?
  consentGdpr            Boolean         @default(false)
  consentGdprAt          DateTime?
  marketingConsent       Boolean         @default(false) // opted in to job alerts / news emails (UK PECR)
  marketingConsentAt     DateTime?
  agreementAccepted      Boolean         @default(false)
  agreementAcceptedAt    DateTime?
  signatureName          String?         // typed e-signature
  signedAt               DateTime?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  documents          CandidateDocument[]
  skills             CandidateSkill[]
  availability       Availability[]
  applications       Application[]
  shifts             Shift[]
  timesheets         Timesheet[]
  employmentHistory  EmploymentHistory[]
  references         CandidateReference[]
  reliabilityIncidents ReliabilityIncident[]
  ratings              CandidateRating[]
  agreements           CandidateAgreement[]

  @@index([status])
}

/// One worker document (Terms of Engagement, KID, 48-hour opt-out) as accepted
/// — or, for the optional opt-out, declined — by a worker. The exact wording is
/// snapshotted at sign-time so the signed document can be reproduced as agreed.
model CandidateAgreement {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  docKey        String // terms-of-engagement | key-information-document | opt-out-48-hour
  title         String
  version       String
  accepted      Boolean   @default(false)
  declined      Boolean   @default(false) // optional docs the worker chose not to sign
  signatureName String? // typed e-signature
  agreementText String?   @db.Text // snapshot of the exact wording accepted
  confirmation  String?   @db.Text // the statement the worker confirmed
  acceptedAt    DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([candidateId, docKey])
  @@index([candidateId])
}

/// One rating of a worker — from a client after a shift, or a staff assessment.
/// The worker's displayed `Candidate.rating` is kept as the average of these.
model CandidateRating {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  byUserId    String    @db.Uuid // the staff member or client contact who rated
  byRole      Role // ADMIN / RECRUITER / CLIENT
  stars       Int // 1..5
  comment     String?
  shiftId     String?
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

// Past jobs the candidate lists during onboarding.
model EmploymentHistory {
  id               String    @id @default(cuid())
  candidateId      String
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  employer         String
  jobTitle         String?
  startDate        DateTime?
  endDate          DateTime?
  current          Boolean   @default(false)
  reasonForLeaving String?

  createdAt        DateTime  @default(now())

  @@index([candidateId])
}

// Referees the candidate provides during onboarding.
model CandidateReference {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  name         String
  relationship String?
  company      String?
  email        String?
  phone        String?
  status       String    @default("pending") // pending | requested | received

  createdAt    DateTime  @default(now())

  @@index([candidateId])
}

model CandidateDocument {
  id           String         @id @default(cuid())
  candidateId  String
  candidate    Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  type         DocumentType
  fileUrl      String         // path in Supabase Storage (private bucket)
  fileName     String?
  // SHA-256 of the uploaded file bytes. Lets the duplicate guard flag when the
  // same file is used for two required checks (e.g. Right to Work and ID).
  fileHash     String?
  // Two-sided documents (driving licence, ID card): the back image. Null for
  // single-sided docs (passport photo page, selfie, CV, etc.).
  backFileUrl  String?
  backFileName String?
  status       DocumentStatus @default(PENDING)
  expiryDate   DateTime?      // for RTW / DBS / certificates
  verifiedById String?        @db.Uuid
  verifiedAt   DateTime?
  notes        String?
  // Why a document was rejected — shown to the candidate so they know what to
  // fix. Prefilled from the AI pre-check summary, editable by the reviewer.
  rejectionReason String?     @db.Text

  // Automated pre-check (assists the admin; never auto-verifies).
  aiCheckVerdict String?      // PASS | WARN | FAIL
  aiCheckSummary String?      @db.Text   // full detail for the reviewer (name, expiry, legibility)
  aiCheckReason  String?      @db.Text   // plain one-sentence reason, candidate-friendly
  // Hash of the AI-read document identity (type + number) — NOT the number
  // itself. Lets the duplicate guard spot the same physical document uploaded as
  // two different photos, without storing the sensitive number in plaintext.
  aiDocFingerprint String?
  aiCheckedAt    DateTime?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([candidateId, type])
  @@index([status])
}

model Availability {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  dayOfWeek    Int       // 0=Sun … 6=Sat
  startTime    String    // "HH:MM"
  endTime      String    // "HH:MM"

  @@unique([candidateId, dayOfWeek, startTime])
}

// ══════════════════════════════════════════════
// SKILLS  (shared taxonomy)
// ══════════════════════════════════════════════

model Skill {
  id         String           @id @default(cuid())
  name       String           @unique
  category   String?

  candidates CandidateSkill[]
  jobs       JobSkill[]
}

model CandidateSkill {
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level       Int?      // 1–5 self-assessed / verified

  @@id([candidateId, skillId])
}

// ══════════════════════════════════════════════
// CLIENTS  (hiring companies)
// ══════════════════════════════════════════════

model Client {
  id            String          @id @default(cuid())
  name          String
  industry      String?
  status        ClientStatus    @default(LEAD)
  addressLine1  String?
  city          String?
  postcode      String?
  billingEmail  String?
  paymentTerms  Int?            // days
  notes         String?

  // ── registration / onboarding tracking (additive, all nullable) ──
  companyRegNo       String?             // Companies House number, for matching + compliance
  registrationSource RegistrationSource? // where they first registered
  submittedAt        DateTime?           // set when they submit onboarding for review
  archivedAt         DateTime?           // soft-delete: hidden from lists, recoverable

  // ── Phase 2 client onboarding: agreement & e-signature ──
  agreementAccepted   Boolean         @default(false)
  agreementAcceptedAt DateTime?
  signatureName       String?         // typed e-signature (authorised signatory)
  signedAt            DateTime?
  agreementText       String?         @db.Text // snapshot of the exact terms accepted at sign-time
  agreementVersion    String?                  // version id of the terms that were accepted

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  contacts      ClientContact[]
  sites         ClientSite[]
  jobs          Job[]
  invoices      Invoice[]
  quotes        Quote[]
  leads         Lead[]
  agreedRates   ClientRate[]

  @@index([status])
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // optional login for the client portal
  userId    String? @unique @db.Uuid
  user      User?   @relation(fields: [userId], references: [id])

  firstName String
  lastName  String
  email     String
  phone     String?
  jobTitle  String?
  isPrimary Boolean @default(false)

  @@index([clientId])
}

model ClientSite {
  id           String  @id @default(cuid())
  clientId     String
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name         String  // e.g. "Birmingham Depot"
  addressLine1 String?
  city         String?
  postcode     String?

  jobs         Job[]
  shifts       Shift[]

  @@index([clientId])
}

// ══════════════════════════════════════════════
// JOBS  (vacancies / assignments)
// ══════════════════════════════════════════════

model Job {
  id           String        @id @default(cuid())
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId       String?
  site         ClientSite?   @relation(fields: [siteId], references: [id])

  title        String
  description  String?
  status       JobStatus     @default(DRAFT)
  openings     Int           @default(1)

  payRate      Decimal       @db.Decimal(10, 2)  // paid to candidate / hour
  chargeRate   Decimal       @db.Decimal(10, 2)  // charged to client / hour
  startDate    DateTime?
  endDate      DateTime?

  // ── recurring / ongoing shifts (additive) ──
  // When recurrenceDays is non-empty the job is an ongoing pattern: booking a
  // worker generates one Shift per matching weekday between startDate and
  // endDate, each at shiftStartTime–shiftEndTime. Empty = a single one-off shift.
  recurrenceDays Int[]      @default([])  // weekdays 0=Sun … 6=Sat
  shiftStartTime String?                  // "HH:mm" local, e.g. "08:00"
  shiftEndTime   String?                  // "HH:mm" local, e.g. "16:00"
  // Open-ended "until further notice": endDate is not fixed. Booking generates a
  // rolling horizon of shifts; admin extends it forward as needed.
  openEnded      Boolean    @default(false)

  // ── job request operational details (all optional, additive) ──
  sector                 String?
  ppe                    String?  // required PPE
  uniform                String?  // uniform / dress code (separate from PPE)
  siteInstructions       String?
  reportingContact       String?
  reportingInstructions  String?
  requiredQualifications String?  // free-text quals / licences required
  experienceRequirements String?  // required experience
  transportRequirements  String?  // transport / travel requirements
  clientRequirements     String?  // client-specific requirements
  bookingUrgency         String?  // "Standard" | "Urgent" | "Emergency"
  dbsRequired            DbsLevel? // minimum DBS level this job needs; null = not needed
  breakInfo              String?
  notes                  String?  // additional notes from the client
  distributionMode       String?  // "manual" | "assisted"

  // ── admin review / approval trail ──
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?       @db.Uuid
  reviewNote   String?       // admin note on approve / reject / request-info

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  skills       JobSkill[]
  applications Application[]
  shifts       Shift[]

  @@index([clientId])
  @@index([status])
}

model JobSkill {
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  required Boolean @default(true)

  @@id([jobId, skillId])
}

model Application {
  id          String            @id @default(cuid())
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  status      ApplicationStatus @default(APPLIED)
  source      String?           // "portal" | "wordpress" | "admin"
  coverNote   String?

  // ── controlled hybrid workflow pipeline (all optional, additive) ──
  matchScore            Float?   // 0-100 suitability score from the matcher
  matchReasons          Json?    // human-readable reasons the candidate matched
  missingRequirements   Json?    // mandatory requirements the candidate is missing

  invitedAt             DateTime?
  invitedById           String?  @db.Uuid
  offerOpenedAt         DateTime? // candidate viewed the offer (delivery tracking)
  responseDeadline      DateTime?
  respondedAt           DateTime?
  candidateResponseNote String?

  submittedToClientAt   DateTime?
  submittedById         String?  @db.Uuid
  adminSummary          String?  // curated blurb shown to the client

  clientDecidedAt       DateTime?
  clientDecisionNote    String?

  bookedAt              DateTime?
  bookedById            String?  @db.Uuid
  shiftId               String?  // the Shift created when booked
  replacesApplicationId String?  // replacement lineage (kept for history)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, candidateId])
  @@index([status])
}

// ══════════════════════════════════════════════
// SHIFTS  (the core unit of temp work)
// ══════════════════════════════════════════════

model Shift {
  id           String      @id @default(cuid())
  jobId        String
  job          Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  siteId       String?
  site         ClientSite? @relation(fields: [siteId], references: [id])
  candidateId  String?
  candidate    Candidate?  @relation(fields: [candidateId], references: [id])

  status       ShiftStatus @default(OPEN)
  startAt      DateTime
  endAt        DateTime
  breakMinutes Int         @default(0)
  payRate      Decimal     @db.Decimal(10, 2)
  chargeRate   Decimal     @db.Decimal(10, 2)
  notes        String?

  // ── shift monitoring / check-in (all nullable, additive) ──
  acknowledgedAt   DateTime?  // worker confirmed they'll attend
  checkInAt        DateTime?  // worker checked in on the day
  checkOutAt       DateTime?  // worker checked out
  lateReportedAt   DateTime?  // worker flagged running late
  absentReportedAt DateTime?  // client reported the worker absent

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  timesheet    Timesheet?

  @@index([status])
  @@index([candidateId])
  @@index([startAt])
}

// ══════════════════════════════════════════════
// TIMESHEETS  (hours worked → approval → pay/invoice)
// ══════════════════════════════════════════════

model Timesheet {
  id           String          @id @default(cuid())
  shiftId      String          @unique
  shift        Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  status       TimesheetStatus @default(DRAFT)
  clockIn      DateTime?
  clockOut     DateTime?
  breakMinutes Int             @default(0)
  hoursWorked  Decimal?        @db.Decimal(5, 2)
  approvedById String?         @db.Uuid
  approvedAt   DateTime?
  rejectReason String?

  invoiceLine  InvoiceLine?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
  @@index([candidateId])
}

// ══════════════════════════════════════════════
// INVOICING
// ══════════════════════════════════════════════

model Invoice {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  number      String        @unique
  status      InvoiceStatus @default(DRAFT)
  periodStart DateTime
  periodEnd   DateTime
  subtotal    Decimal       @db.Decimal(10, 2) @default(0)
  vat         Decimal       @db.Decimal(10, 2) @default(0)
  total       Decimal       @db.Decimal(10, 2) @default(0)
  dueDate     DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines       InvoiceLine[]

  @@index([clientId])
  @@index([status])
}

model InvoiceLine {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timesheetId String?    @unique
  timesheet   Timesheet? @relation(fields: [timesheetId], references: [id])

  description String
  hours       Decimal    @db.Decimal(5, 2)
  rate        Decimal    @db.Decimal(10, 2)
  amount      Decimal    @db.Decimal(10, 2)
}

// ══════════════════════════════════════════════
// ENQUIRIES  (raw submissions from WordPress forms)
// ══════════════════════════════════════════════

model Enquiry {
  id          String        @id @default(cuid())
  type        EnquiryType
  status      EnquiryStatus @default(NEW)
  source      String        @default("wordpress")

  name        String?
  email       String?
  phone       String?
  company     String?
  message     String?
  payload     Json?         // full raw form payload, for anything extra

  spam        Boolean       @default(false) // flagged by the spam filter / honeypot
  spamReason  String?       // why it was flagged (for review)
  lead        Lead?         // CRM lead created from this enquiry

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type, status])
  @@index([spam])
}

// ══════════════════════════════════════════════
// NOTIFICATIONS + AUDIT
// ══════════════════════════════════════════════

model Notification {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // "shift_offered", "timesheet_approved", ...
  title     String
  body      String?
  link      String?
  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

// Expo push tokens — one per device a user signs in on. Used to deliver push
// notifications for the mobile app (additive; safe to drop with no data loss).
model PushToken {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?  // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id])

  action    String   // "candidate.verified", "shift.assigned", ...
  entity    String   // "Candidate"
  entityId  String
  meta      Json?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

// ══════════════════════════════════════════════
// MESSAGING  (member ↔ agency conversations)
// ══════════════════════════════════════════════

model Conversation {
  id            String           @id @default(cuid())
  kind          ConversationKind
  // the candidate or client-contact user this thread belongs to
  memberUserId  String           @db.Uuid
  member        User             @relation(fields: [memberUserId], references: [id], onDelete: Cascade)
  subject       String?
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())

  messages      Message[]

  @@index([memberUserId])
  @@index([kind, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderUserId   String       @db.Uuid
  senderIsStaff  Boolean      // true = agency staff, false = the member
  senderName     String       // denormalised for display
  body           String
  readAt         DateTime?    // set when the *recipient* has read it

  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ══════════════════════════════════════════════
// MATCHING WEIGHTS  (admin-tunable scoring factors — singleton row)
// ══════════════════════════════════════════════

model MatchWeights {
  id           String   @id @default("default")
  skills       Float    @default(35)
  compliance   Float    @default(15)
  rightToWork  Float    @default(10)
  availability Float    @default(15)
  rating       Float    @default(10)
  reliability  Float    @default(10)
  proximity    Float    @default(5)

  updatedById  String?  @db.Uuid
  updatedAt    DateTime @updatedAt
}

// ══════════════════════════════════════════════
// RELIABILITY MONITORING  (internal — never shown to clients)
// ══════════════════════════════════════════════

enum ReliabilityType {
  NO_SHOW
  LATE_CANCELLATION
  LATENESS
  MISSED_CHECKIN
  LEFT_EARLY
  TIMESHEET_MISSING
  NO_RESPONSE
  WITHDREW
  CLIENT_COMPLAINT
  NEGATIVE_FEEDBACK
  POSITIVE_FEEDBACK
  DISPUTE
  OTHER
}

enum ReliabilityStatus {
  CONFIRMED     // verified — counts toward the concern level
  UNCONFIRMED   // reported, not yet verified — counts at reduced weight
  DISPUTED      // candidate disputed / under review — does not count
  RESOLVED      // dealt with — does not count
  REMOVED       // incorrect / withdrawn — kept for audit, does not count
}

model ReliabilityIncident {
  id             String            @id @default(cuid())
  candidateId    String
  candidate      Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  type           ReliabilityType
  severity       Int               @default(3)  // 1 (minor) – 5 (serious)
  status         ReliabilityStatus @default(UNCONFIRMED)
  reason         String
  notes          String?
  evidenceSource String?           // e.g. "Client report", "System check-in", "Timesheet"
  shiftId        String?           // related booking / shift
  jobId          String?
  occurredAt     DateTime          @default(now())
  scoreImpact    Float             @default(0)  // concern points (negative = positive feedback)
  weightFactor   Float             @default(1)  // reduce for older / isolated incidents

  reportedById   String?           @db.Uuid     // administrator responsible
  reviewDate     DateTime?
  appealNote     String?           // candidate correction / appeal
  appealedAt     DateTime?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([candidateId])
  @@index([status])
}

// ══════════════════════════════════════════════
// QUOTES — rate settings for the quote calculator (CRM Phase 1)
// Singleton row (id "default"), edited by admins. Percentages are stored as
// plain numbers (12.07 = 12.07%). Money follows the Decimal(10,2) convention.
// ══════════════════════════════════════════════

model RateSettings {
  id                   String   @id @default("default")
  holidayPct           Float    @default(12.07)  // holiday pay accrual, on top of pay
  employerNiPct        Float    @default(15)     // employer National Insurance
  niThresholdWeekly    Decimal  @default(96)  @db.Decimal(10, 2) // NI secondary threshold, £/week
  pensionPct           Float    @default(3)      // employer auto-enrolment contribution
  pensionLowerWeekly   Decimal  @default(120) @db.Decimal(10, 2) // qualifying earnings lower limit, £/week
  bufferPct            Float    @default(1)      // sick pay / insurance buffer
  defaultMarginPerHour Decimal  @default(1.75) @db.Decimal(10, 2) // Starff margin, £/hour
  minimumWage          Decimal  @default(12.71) @db.Decimal(10, 2) // National Living Wage 21+, £/hour
  londonLivingWage     Decimal  @default(15.45) @db.Decimal(10, 2) // voluntary London Living Wage, £/hour

  updatedById          String?  @db.Uuid
  updatedAt            DateTime @updatedAt
}

// ══════════════════════════════════════════════
// QUOTES — saved quotes (CRM Phase 1)
// A quote is for an existing Client OR a prospect (company name only). Each
// line is one role priced by the quote calculator; figures are worked out by
// the API on save, never trusted from the browser. The rates used are kept in
// ratesSnapshot so an old quote still explains itself after rates change.
// "Expired" is not stored: a DRAFT/SENT quote past validUntil shows as expired.
// ══════════════════════════════════════════════

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

model Quote {
  id            String      @id @default(cuid())
  number        String      @unique // Q-2026-0001
  status        QuoteStatus @default(DRAFT)

  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  prospectName  String?     // company name when not (yet) a client
  leadId        String?     // CRM lead this quote was made for (CRM Phase 2)
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactName   String?
  contactEmail  String?

  title         String?
  notes         String?
  validUntil    DateTime

  total         Decimal     @default(0) @db.Decimal(12, 2)
  totalCost     Decimal     @default(0) @db.Decimal(12, 2)
  profit        Decimal     @default(0) @db.Decimal(12, 2)
  ratesSnapshot Json?

  createdById   String?     @db.Uuid
  sentAt        DateTime?
  decidedAt     DateTime?   // accepted or declined
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  lines         QuoteLine[]
  agreedRates   ClientRate[]

  @@index([clientId])
  @@index([leadId])
  @@index([status])
  @@index([validUntil])
}

model QuoteLine {
  id              String  @id @default(cuid())
  quoteId         String
  quote           Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position        Int     @default(0)

  description     String  // e.g. "Warehouse operative"
  payRate         Decimal @db.Decimal(10, 2)
  marginPerHour   Decimal @db.Decimal(10, 2)
  hoursPerShift   Decimal @db.Decimal(5, 2)
  shifts          Int
  temps           Int
  shiftType       String  // standard | night | weekend | bank_holiday
  pensionEnrolled Boolean @default(true)

  costPerHour     Decimal @db.Decimal(10, 2)
  chargeRate      Decimal @db.Decimal(10, 2)
  totalHours      Decimal @db.Decimal(10, 2)
  total           Decimal @db.Decimal(12, 2)
  totalCost       Decimal @db.Decimal(12, 2)
  profit          Decimal @db.Decimal(12, 2)

  @@index([quoteId])
}

// ══════════════════════════════════════════════
// LEADS — sales pipeline + activity log (CRM Phase 2)
// A lead is a company we are trying to win as a client. It can start from a
// website enquiry (enquiryId), from an existing Client still at LEAD/PROSPECT
// (clientId), or be added by hand / by the AI salesperson. Every call, email
// and note goes in LeadActivity; stage changes are logged there too, so the
// activity list is the full story of the lead.
// ══════════════════════════════════════════════

enum LeadStage {
  NEW // not contacted yet
  CONTACTED // we've reached out / spoken
  QUALIFIED // real need, right fit, decision-maker known
  QUOTED // a quote has gone out
  READY_TO_CLOSE // verbally agreed, sorting terms / first booking
  WON // became a client
  LOST // not going ahead (lostReason says why)
}

enum LeadSource {
  ENQUIRY // website form (Enquiry)
  CLIENT // existing Client record at LEAD/PROSPECT
  MANUAL // added by staff
  AI // added by the AI salesperson
  REFERRAL
  OUTBOUND // cold outreach / prospect list
}

enum LeadActivityType {
  CALL
  EMAIL
  NOTE
  MEETING
  STAGE_CHANGE // written by the API when the stage moves
}

model Lead {
  id     String     @id @default(cuid())
  stage  LeadStage  @default(NEW)
  source LeadSource @default(MANUAL)

  companyName    String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  contactRole    String?
  sector         String?
  city           String?
  postcode       String?
  estimatedValue Decimal? @db.Decimal(12, 2) // rough £ per month, if known
  notes          String?  @db.Text

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  enquiryId String?  @unique // one lead per enquiry
  enquiry   Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  ownerId        String?   @db.Uuid // staff member responsible
  createdById    String?   @db.Uuid
  createdByAi    Boolean   @default(false)
  nextActionAt   DateTime? // when to follow up next
  lastActivityAt DateTime?
  stageChangedAt DateTime  @default(now())
  lostReason     String?
  archivedAt     DateTime?
  /// They asked not to be emailed (e.g. replied "unsubscribe"). Nothing is drafted or sent while set.
  unsubscribedAt DateTime?
  unsubscribeNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  quotes         Quote[]
  aiDrafts       AiDraft[]
  inboundEmails  InboundEmail[]

  @@index([stage])
  @@index([clientId])
  @@index([ownerId])
  @@index([nextActionAt])
  @@index([contactEmail])
}

model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type      LeadActivityType
  direction String? // "inbound" | "outbound" for calls and emails
  subject   String?
  body      String?          @db.Text
  outcome   String? // e.g. "no answer", "call back Tuesday"
  meta      Json? // stage change from/to, email ids, etc.

  occurredAt  DateTime @default(now())
  createdById String?  @db.Uuid
  byAi        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([leadId, occurredAt])
}

// ══════════════════════════════════════════════
// AGREED RATES (CRM Phase 3)
// The per-role rates a client agreed to, copied from their accepted quote when
// a lead is converted to a client. One row per quote line. Staff can see them
// on the client's profile; they are the reference when booking that client.
// ══════════════════════════════════════════════

model ClientRate {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quoteId       String?  // the accepted quote these came from
  quote         Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  position      Int      @default(0)

  role          String   // e.g. "Warehouse operative"
  shiftType     String   // standard | night | weekend | bank_holiday
  payRate       Decimal  @db.Decimal(10, 2) // paid to the worker / hour
  chargeRate    Decimal  @db.Decimal(10, 2) // charged to the client / hour
  marginPerHour Decimal  @db.Decimal(10, 2)
  hoursPerShift Decimal? @db.Decimal(5, 2)
  pensionEnrolled Boolean @default(true)

  agreedAt      DateTime @default(now())
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())

  @@index([clientId])
  @@index([quoteId])
}

// ─── CRM Phase 4b: AI salesperson approvals queue ───────────────────────────
// Follow-ups the AI salesperson drafts (every weekday morning, or on demand)
// wait here until staff send, edit-and-send or skip them. Nothing is sent
// without a person pressing Send.

enum AiDraftStatus {
  PENDING // waiting for staff
  SENT // approved and emailed
  SKIPPED // staff chose not to send
  STALE // the lead moved on (emailed, won, lost, archived) before review
}

model AiDraft {
  id     String        @id @default(cuid())
  leadId String
  lead   Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status AiDraftStatus @default(PENDING)
  /// London day the draft was made for (yyyy-mm-dd); one draft per lead per day.
  forDay String

  subject          String
  body             String  @db.Text
  callScript       String? @db.Text
  reasoning        String? @db.Text
  warnings         Json?
  nextFollowUpDays Int     @default(3)
  model            String?
  /// "schedule" (07:30 run) or "manual" (Draft today's list now)
  trigger          String  @default("schedule")

  decidedAt   DateTime?
  decidedById String?   @db.Uuid
  skipReason  String?
  /// The EMAIL activity written when it was sent.
  activityId  String?

  // Phase 4c: answers to employer replies.
  /// "FOLLOW_UP" (morning run) or "REPLY" (answer to an inbound email)
  kind              String     @default("FOLLOW_UP")
  /// interested | question | not_now | not_interested | wrong_person | other
  intent            String?
  theirSummary      String?
  /// The stage the AI suggests moving the lead to (applied only if staff tick it).
  suggestedStage    LeadStage?
  suggestedReason   String?
  inboundEmailId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, forDay])
  @@index([status, createdAt])
}

// ─── CRM Phase 4c: employer replies received through Resend inbound ─────────
enum InboundStatus {
  RECEIVED // stored, not processed yet
  MATCHED // linked to a lead and handled
  UNMATCHED // from an address no lead has
  UNSUBSCRIBED // they asked to stop; leads with this address are opted out
  IGNORED // out-of-office / auto-reply, or dismissed by staff
  FAILED // could not fetch or process
}

model InboundEmail {
  id            String        @id @default(cuid())
  /// Resend's email_id; makes the webhook safe to retry.
  resendEmailId String        @unique
  status        InboundStatus @default(RECEIVED)
  fromEmail     String
  fromName      String?
  toEmails      Json?
  subject       String?
  /// Their new text, with the quoted thread removed.
  text          String?       @db.Text
  messageId     String?
  receivedAt    DateTime      @default(now())
  leadId        String?
  lead          Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  intent        String?
  summary       String?
  error         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([fromEmail])
}

// ─── CRM Phase 4d: AI prospecting via Apollo ─────────────────────────────────
// Once a week (or on demand) the API asks Apollo for London companies that are
// hiring warehouse staff, finds their Ops / Site / Warehouse manager and puts
// them here as suggestions. Nothing becomes a Lead until staff press Accept.
// A weekly cap (APOLLO_WEEKLY_CAP, default 20) limits Apollo credits.

enum SuggestedLeadStatus {
  PENDING // waiting for staff
  ACCEPTED // turned into a Lead (leadId)
  REJECTED // staff said no; never suggested again
}

model SuggestedLead {
  id      String              @id @default(cuid())
  status  SuggestedLeadStatus @default(PENDING)
  /// ISO week the suggestion was made in (e.g. 2026-W47); the weekly cap counts these.
  weekKey String
  /// "schedule" (Monday run) or "manual" (Find leads now)
  trigger String              @default("schedule")

  apolloOrgId     String  @unique
  companyName     String
  domain          String?
  website         String?
  companyLinkedin String?
  companyPhone    String?
  employees       Int?
  city            String?

  apolloPersonId  String?
  contactName     String?
  contactRole     String?
  contactEmail    String?
  emailStatus     String?
  contactLinkedin String?

  /// Why it was suggested, in plain words (e.g. hiring warehouse operatives in London).
  reason String? @db.Text

  leadId       String?
  decidedAt    DateTime?
  decidedById  String?   @db.Uuid
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([weekKey])
  @@index([domain])
}
